<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Rule 1: no internet. tools:node="remove" stops any library from adding it back. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- Rule 7: no backups. allowBackup covers Android 11 and below; the two rule files
         exclude everything from cloud backup and device-to-device transfer on newer versions. -->
    <application
        android:name=".HeyBuddyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Rule 15: the launcher activity is the only exported component. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Rule 15: Compose brings this exported receiver along. It only serves developer tools
             (profile install over adb); the app still installs its startup profile without it.
             MissingClass is ignored because lint cannot resolve a library class we are removing. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
