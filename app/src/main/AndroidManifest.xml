<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Rule 1: no internet. tools:node="remove" stops any library from adding it back. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <!-- Spec 7.3 (Task 2.1): ML Kit's logging parts ask for this; Hey Buddy never needs it. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- enableOnBackInvokedCallback: the back-gesture preview on Android 14+ (spec 5.14, item 4).
         Rule 7: no backups. allowBackup covers Android 11 and below; the two rule files
         exclude everything from cloud backup and device-to-device transfer on newer versions. -->
    <application
        android:name=".HeyBuddyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        tools:ignore="UnusedAttribute"
        android:theme="@style/Theme.HeyBuddy">

        <!-- Rule 1 and spec 7.3 (Task 2.1): ML Kit brings Google's usage-logging parts
             (data-transport). They could never send anything (no INTERNET permission), but they are
             removed completely, so nothing even tries. Recognition itself runs on the phone. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:node="remove" />

        <!-- Rule 15 (owner decision, Task 1.10m): profileinstaller adds an EXPORTED receiver (used by
             benchmark tools to trigger profile installs). Removed, so the launcher activity stays
             the only exported component; profiles are still installed by its startup initializer. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />

        <!-- Rule 15: the launcher activity is the only exported component. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Rule 15: Compose brings this exported receiver along. It only serves developer tools
             (profile install over adb); the app still installs its startup profile without it.
             MissingClass is ignored because lint cannot resolve a library class we are removing. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
